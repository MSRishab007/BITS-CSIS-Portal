# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Must be False on the college server.
DEBUG=True

# Comma-separated host names the site is served on.
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) needed for form posts behind Nginx/HTTPS.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Set to True once the site is served over HTTPS.
SECURE_COOKIES=False

# Only email addresses on these domains may have accounts (comma-separated).
# Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAINS=pilani.bits-pilani.ac.in

DEPARTMENT_NAME=Department

# Where the SQLite database and uploaded bills live. Keep both OUTSIDE the
# web root and include both in backups.
DATABASE_PATH=db.sqlite3
MEDIA_ROOT=media
